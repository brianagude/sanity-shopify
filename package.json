{
  "name": "sanity-shopify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "predev": "npm run typegen",
    "prebuild": "npm run typegen",
    "typegen": "sanity schema extract --enforce-required-fields && sanity typegen generate",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "@sanity/icons": "^3.7.0",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^3.82.0",
    "@shopify/storefront-api-client": "^1.0.6",
    "@tailwindcss/cli": "^4.1.3",
    "@vercel/og": "^0.6.8",
    "clsx": "^2.1.1",
    "next": "15.2.4",
    "next-sanity": "^9.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanity": "^3.82.0",
    "sanity-plugin-asset-source-unsplash": "^3.0.3",
    "sanity-plugin-media": "^3.0.2",
    "sanity-plugin-shopify-assets": "^1.2.0",
    "sonner": "^2.0.3",
    "styled-components": "^6.1.17",
    "tailwind-variants": "^1.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.3",
    "typescript": "^5"
  }
}
